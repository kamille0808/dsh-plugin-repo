# DSH 插件仓库 · 发现器 · ECS 部署环境变量
#
# 安装位置：/etc/dsh-harvester/harvester.env
#   sudo mkdir -p /etc/dsh-harvester
#   sudo cp harvester.env.example /etc/dsh-harvester/harvester.env
#   sudo chown root:root /etc/dsh-harvester/harvester.env
#   sudo chmod 600 /etc/dsh-harvester/harvester.env     # 里面有 PG 口令
#
# 改完执行：sudo systemctl daemon-reload && sudo systemctl restart dsh-harvester.timer
#
# ── 必填：数据库 ───────────────────────────────────────────────
# 连接串必须带 TLS 参数。不要用 sslmode=require（新版 pg 当 verify-full 处理，
# RDS 私有 CA 会报 self-signed）。
#   联调：?sslmode=no-verify
#   正式：?sslmode=verify-full&sslrootcert=/etc/dsh-harvester/rds-ca.pem
DATABASE_URL=postgres://dsh_plugin_harvester_rw:<在此填口令>@47.101.216.5:5432/dsh_plugin_repo_dev?sslmode=no-verify

# ── 建议填：GitHub 只读 PAT ───────────────────────────────────
# 不填则 GitHub 匿名配额 60 次/小时，L4 核验会大量失败。
# 需要 repo 读权限 + 搜索 API 权限。
GITHUB_TOKEN=ghp_<在此填只读 PAT>

# ── 必填：发布到 nginx ────────────────────────────────────────
# publisher=nginx：发现器与 nginx 同机，直接原子替换写入这个目录
HARVESTER_PUBLISHER=nginx

# nginx 的 root 目录——填你已有站点目录的实际路径。
# 该目录必须对运行发现器的用户可写，否则发布失败。
HARVESTER_NGINX_ROOT=/var/www/<你的站点目录>

# 索引的最终公开地址前缀。
# ⚠️ 这一个值有两个用途：format-1 里相对图标的解析基准 + 每轮发布前的
#    parseMarketIndex 自验基准。填错不会报错，但自验会跑在错误的基准上。
#    这也是官方 DSH「发现 → 添加索引源」里要填的地址。
HARVESTER_INDEX_BASE_URL=https://<你的域名>

# 发布后回源自检：GET 公开地址的 index.json，确认 nginx 已把新文件发出来。
HARVESTER_NGINX_PROBE_URL=https://<你的域名>

# ── 出网代理（ECS 在国内时强烈建议）────────────────────────────
# Node 的 fetch 默认**不认** HTTP(S)_PROXY，必须显式开 NODE_USE_ENV_PROXY=1。
# 不开这个开关的现象是「连接超时」而不是「连不上代理」，极难排查。
# 启动日志里若出现「配置了出网代理，但未开启 NODE_USE_ENV_PROXY=1」就是没配对。
#
# 如果 ECS 在香港/新加坡等海外节点，出网正常，这两项可以不填。
#HTTPS_PROXY=http://127.0.0.1:7890
#NODE_USE_ENV_PROXY=1
#NO_PROXY=127.0.0.1,localhost,47.101.216.5

# ── 抓取节奏（网络不稳时调大）────────────────────────────────
HARVESTER_HTTP_TIMEOUT_MS=60000
HARVESTER_HTTP_RETRIES=5
HARVESTER_HTTP_CONCURRENCY=4
# GitHub 匿名 60 次/小时，认证 5000 次/小时；留余量
HARVESTER_GITHUB_RATE_PER_HOUR=4500

# ── 轮次规模 ──────────────────────────────────────────────────
HARVESTER_VERIFY_MAX_PER_RUN=400
HARVESTER_CANDIDATE_PER_RUN=100
HARVESTER_GONE_MISS_THRESHOLD=3

# ── 发布守门 ──────────────────────────────────────────────────
# 候选数相对上一轮跌超这个比例就跳过本轮发布（信源大面积失败的保险丝）
HARVESTER_MAX_CATALOG_DROP=0.4

# ── 浏览页 ────────────────────────────────────────────────────
# 浏览页最多收录多少条（按共识票→star 排序取前 N）。完整目录在 PG 与索引里。
HARVESTER_BROWSE_LIMIT=5000

# ── 日志 ──────────────────────────────────────────────────────
HARVESTER_LOG_LEVEL=info
